---
import { coverUrl, formatDate, isoDate, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="posts-empty">Nothing here yet.</p>
  ) : (
    <ul class="posts">
      {posts.map((post, index) => (
        <li>
          <a class="post-link" href={postUrl(post)}>
            <img
              class="cover"
              src={coverUrl(post.data.cover)}
              alt=""
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
              transition:name={`cover-${post.collection}-${post.id}`}
              transition:animate="initial"
            />
            <h2 class="post-title">{post.data.title}</h2>
          </a>
          <p class="post-date">
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          </p>
        </li>
      ))}
    </ul>
  )
}
