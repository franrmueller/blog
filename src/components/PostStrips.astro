---
import { coverUrl, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="posts-empty">Nothing here yet.</p>
  ) : (
    <ul class="strips">
      {posts.map((post, index) => (
        <li>
          <a class="strip" href={postUrl(post)}>
            <img
              class="strip-cover"
              src={coverUrl(post.data.cover)}
              alt=""
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              transition:name={`cover-${post.collection}-${post.id}`}
              transition:animate="initial"
            />
            <h3 class="strip-title">{post.data.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  )
}
