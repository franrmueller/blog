---
/**
 * The share control at the end of a post: a paper plane (like Telegram's send arrow) that unfolds a row of
 * icons beside it (copy the link, LinkedIn, X, email), each naming itself in
 * a tooltip on hover or focus (see [data-tip] in global.css). On touch
 * screens the page script opens the system share sheet instead. Without
 * JavaScript the row stays folded, like the footer's notes.
 */
interface Props {
  title: string;
  /** Absolute URL of the post, the same as its canonical link. */
  url: string;
  /** The row's id. A page with two share controls (the corner menu has one too) gives the second its own. */
  id?: string;
}

const { title, url, id = 'share-note' } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const x = `https://x.com/intent/post?text=${encodedTitle}&url=${encodedUrl}`;
const email = `mailto:?subject=${encodedTitle}&body=${encodedUrl}`;

// Line icons drawn like the rest of the chrome.
const icon = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.75',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;
---

<div class="popover share" data-title={title} data-url={url}>
  <button class="popover-button" type="button" aria-label="Share" data-tip="Share" aria-expanded="false" aria-controls={id}>
    <svg {...icon}>
      <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
      <path d="m21.854 2.147-10.94 10.939" />
    </svg>
  </button>
  <ul class="popover-note share-links" id={id}>
    <li>
      <button class="share-copy" type="button" aria-label="Copy link" data-tip="Copy link">
        <svg class="share-copy-link" {...icon}>
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        <svg class="share-copy-done" {...icon}>
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </button>
    </li>
    <li>
      <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" data-tip="LinkedIn">
        <svg {...icon}>
          <circle cx="5.75" cy="5" r="1.6" fill="currentColor" stroke="none" />
          <path d="M5.75 9.75v10" />
          <path d="M10.75 19.75v-10" />
          <path d="M10.75 13.75a3.75 3.75 0 0 1 7.5 0v6" />
        </svg>
      </a>
    </li>
    <li>
      <a href={x} target="_blank" rel="noopener noreferrer" aria-label="X" data-tip="X">
        <svg {...icon}>
          <path d="m5 4 14 16" />
          <path d="m19 4-4.8 5.4" />
          <path d="M9.8 14.6 5 20" />
        </svg>
      </a>
    </li>
    <li>
      <a href={email} aria-label="Email" data-tip="Email">
        <svg {...icon}>
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
      </a>
    </li>
  </ul>
  <span class="sr-only" role="status"></span>
</div>
