---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE, LIBRARY_PUBLIC } from '../site';
import ThemeToggle from '../components/ThemeToggle.astro';
import LibraryLink from '../components/LibraryLink.astro';
import { SHARE_WIDTH, SHARE_HEIGHT } from '../lib/share-image';
import sunflowerSvg from '../../public/favicon.svg?raw';

// The favicon, recoloured so it can sit muted and turn coral like the nav.
const sunflower = sunflowerSvg.replace('fill="#e07a6a"', 'fill="currentColor"');

interface Props {
  title?: string;
  description?: string;
  /** Root-relative or absolute URL of the 1200×630 JPEG share image, for link previews. */
  image?: string;
  type?: 'website' | 'article';
  /** Article pages pass their ISO date; emitted as article:published_time. */
  publishedTime?: string;
  /** Home uses the wider column; header and footer follow it. */
  wide?: boolean;
  /** The largest image above the fold, requested before the fonts. */
  preloadImage?: string;
  /** Pages with a prose body preload the body font. */
  preloadBody?: boolean;
  /** Pages that show the title face in italic above the fold preload that cut too. */
  preloadSerifItalic?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  wide = false,
  preloadImage,
  preloadBody = false,
  preloadSerifItalic = false,
} = Astro.props;

const serifPreload = preloadSerifItalic ? [{ style: 'normal' }, { style: 'italic' }] : [{ style: 'normal' }];

const column = wide ? 'column column-wide' : 'column';

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const nav = [
  { key: 'work', href: '/work/', label: 'Work' },
  { key: 'mind', href: '/mind/', label: 'Mind' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const currentSection = path.split('/')[1];
const current = (key: string) => {
  if (currentSection !== key) return undefined;
  return path === `/${key}` ? 'page' : 'true';
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f14" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ec" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content={String(SHARE_WIDTH)} />}
    {ogImage && <meta property="og:image:height" content={String(SHARE_HEIGHT)} />}
    {ogImage && <meta property="og:image:type" content="image/jpeg" />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <Font cssVariable="--font-serif" preload={serifPreload} />
    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    {preloadBody ? <Font cssVariable="--font-body" preload={[{ style: 'normal', weight: 400 }]} /> : <Font cssVariable="--font-body" />}
  </head>
  <body>
    <header class={`site-header ${column}`}>
      <a class="site-home" href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V21h14V9.5" />
          <path d="M10 21v-6h4v6" />
        </svg>
      </a>
      <div class="site-right">
        <nav class="site-nav" aria-label="Sections">
          {nav.map((item) => <a href={item.href} aria-current={current(item.key)}>{item.label}</a>)}
          {LIBRARY_PUBLIC && <LibraryLink current={current('library')} />}
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <!-- Appears top-right once the header has scrolled away; click unfolds the header row. -->
    <div class="corner">
      <nav class="corner-row" id="corner-menu" aria-label="Sections">
        <a class="corner-home" href="/" aria-label="Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9.5V21h14V9.5" />
            <path d="M10 21v-6h4v6" />
          </svg>
        </a>
        {nav.map((item) => <a href={item.href} aria-current={current(item.key)}>{item.label}</a>)}
        {LIBRARY_PUBLIC && <LibraryLink current={current('library')} />}
        <ThemeToggle maskId="sun-moon-mask-corner" />
      </nav>
      <button class="corner-mark" type="button" aria-expanded="false" aria-controls="corner-menu" aria-label="Menu" set:html={sunflower} />
    </div>
    <main>
      <slot />
    </main>
    <footer class={`site-footer ${column}`}>
      <p>{SITE.shortName}</p>
    </footer>
    <script is:inline>
      // The JavaScript on the site: the theme toggle and the corner menu.
      // Without it the site follows the system scheme and the header stays at the top.
      (() => {
        const root = document.documentElement;

        // Theme: every sun/moon button on the page toggles it.
        const buttons = [...document.querySelectorAll('[data-toggle-theme]')];
        const current = () =>
          root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const sync = () => {
          const theme = current();
          for (const b of buttons) {
            b.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
          }
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = theme === 'light' ? '#f5f2ec' : '#0b0f14';
          }
        };
        // Read the stored choice again: after a back/forward cache restore
        // (the startup script does not run then) and when another tab changes it.
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {}
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
          else delete root.dataset.theme;
          sync();
        };
        for (const b of buttons) {
          b.addEventListener('click', () => {
            const next = current() === 'light' ? 'dark' : 'light';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
            sync();
          });
        }
        addEventListener('pageshow', (event) => {
          if (event.persisted) apply();
        });
        addEventListener('storage', (event) => {
          if (event.key === 'theme') apply();
        });
        sync();

        // Corner menu: the sunflower shows while the header is off screen.
        const corner = document.querySelector('.corner');
        const header = document.querySelector('.site-header');
        const mark = corner && corner.querySelector('.corner-mark');
        if (!corner || !header || !mark || !('IntersectionObserver' in window)) return;
        const setOpen = (open) => {
          corner.classList.toggle('is-open', open);
          mark.setAttribute('aria-expanded', String(open));
        };
        new IntersectionObserver(([entry]) => {
          const away = !entry.isIntersecting;
          corner.classList.toggle('is-visible', away);
          if (!away) setOpen(false);
        }).observe(header);
        mark.addEventListener('click', () => setOpen(!corner.classList.contains('is-open')));
        addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
        addEventListener('click', (event) => {
          if (!corner.contains(event.target)) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
