---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative or absolute URL of the page's cover, for link previews. */
  image?: string;
  type?: 'website' | 'article';
  /** Home uses the wider column; header and footer follow it. */
  wide?: boolean;
  /** The largest image above the fold, requested before the fonts. */
  preloadImage?: string;
  /** Pages with a prose body preload the body font. */
  preloadBody?: boolean;
  /** Pages that show the title face in italic above the fold preload that cut too. */
  preloadSerifItalic?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  wide = false,
  preloadImage,
  preloadBody = false,
  preloadSerifItalic = false,
} = Astro.props;

const serifPreload = preloadSerifItalic ? [{ style: 'normal' }, { style: 'italic' }] : [{ style: 'normal' }];

const column = wide ? 'column column-wide' : 'column';

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const nav = [
  { key: 'work', href: '/work/', label: 'Work' },
  { key: 'mind', href: '/mind/', label: 'Mind' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const currentSection = path.split('/')[1];
const current = (key: string) => {
  if (currentSection !== key) return undefined;
  return path === `/${key}` ? 'page' : 'true';
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f14" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ec" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <Font cssVariable="--font-serif" preload={serifPreload} />
    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    {preloadBody ? <Font cssVariable="--font-body" preload={[{ style: 'normal', weight: 400 }]} /> : <Font cssVariable="--font-body" />}
  </head>
  <body>
    <header class={`site-header ${column}`}>
      <a class="site-home" href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V21h14V9.5" />
          <path d="M10 21v-6h4v6" />
        </svg>
      </a>
      <div class="site-right">
        <nav class="site-nav" aria-label="Sections">
          {nav.map((item) => <a href={item.href} aria-current={current(item.key)}>{item.label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" data-toggle-theme aria-label="Switch theme">
          <svg class="sun-moon" viewBox="0 0 24 24" aria-hidden="true">
            <mask id="sun-moon-mask">
              <rect width="24" height="24" fill="#fff" />
              <circle class="hole" cx="22" cy="2" r="6" fill="#000" />
            </mask>
            <circle cx="12" cy="12" r="6" fill="currentColor" mask="url(#sun-moon-mask)" />
            <path class="rays" d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M4.6 19.4l1.4-1.4M18 6l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class={`site-footer ${column}`}>
      <p>{SITE.shortName}</p>
    </footer>
    <script is:inline>
      // The one piece of JavaScript on the site: the theme toggle.
      // Without it the site simply follows the system preference.
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-toggle-theme]');
        if (!button) return;
        const current = () =>
          root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const sync = () => {
          const theme = current();
          button.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = theme === 'light' ? '#f5f2ec' : '#0b0f14';
          }
        };
        // Read the stored choice again: after a back/forward cache restore
        // (the startup script does not run then) and when another tab changes it.
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {}
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
          else delete root.dataset.theme;
          sync();
        };
        button.addEventListener('click', () => {
          const next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          sync();
        });
        addEventListener('pageshow', (event) => {
          if (event.persisted) apply();
        });
        addEventListener('storage', (event) => {
          if (event.key === 'theme') apply();
        });
        sync();
      })();
    </script>
  </body>
</html>
