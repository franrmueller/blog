---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative or absolute URL of the page's cover, for link previews. */
  image?: string;
  type?: 'website' | 'article';
  /** Home uses the wider column; header and footer follow it. */
  wide?: boolean;
  /** The largest image above the fold, requested before the fonts. */
  preloadImage?: string;
  /** Pages with a prose body preload the body font. */
  preloadBody?: boolean;
}

const { title, description = SITE.description, image, type = 'website', wide = false, preloadImage, preloadBody = false } = Astro.props;

const column = wide ? 'column column-wide' : 'column';

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const nav = [
  { key: 'work', href: '/work/', label: 'Work' },
  { key: 'mind', href: '/mind/', label: 'Mind' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const currentSection = path.split('/')[1];
const current = (key: string) => {
  if (currentSection !== key) return undefined;
  return path === `/${key}` ? 'page' : 'true';
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f14" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ec" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    {preloadBody ? <Font cssVariable="--font-body" preload={[{ style: 'normal', weight: 400 }]} /> : <Font cssVariable="--font-body" />}
  </head>
  <body>
    <header class={`site-header ${column}`}>
      <a class="site-home" href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V21h14V9.5" />
          <path d="M10 21v-6h4v6" />
        </svg>
      </a>
      <div class="site-right">
        <nav class="site-nav" aria-label="Sections">
          {nav.map((item) => <a href={item.href} aria-current={current(item.key)}>{item.label}</a>)}
        </nav>
        <div class="theme" role="group" aria-label="Theme">
          <button class="theme-light" type="button" data-set-theme="light" aria-label="Light theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
          <button class="theme-dark" type="button" data-set-theme="dark" aria-label="Dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class={`site-footer ${column}`}>
      <p>{SITE.shortName}</p>
    </footer>
    <script is:inline>
      // The one piece of JavaScript on the site: the theme toggle.
      // Without it the site simply follows the system preference.
      (() => {
        const root = document.documentElement;
        const buttons = document.querySelectorAll('[data-set-theme]');
        const sync = () => {
          const theme =
            root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme));
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = theme === 'light' ? '#f5f2ec' : '#0b0f14';
          }
        };
        for (const b of buttons) {
          b.addEventListener('click', () => {
            root.dataset.theme = b.dataset.setTheme;
            try {
              localStorage.setItem('theme', b.dataset.setTheme);
            } catch {}
            sync();
          });
        }
        sync();
      })();
    </script>
  </body>
</html>
