---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE, LIBRARY_PUBLIC } from '../site';
import ThemeToggle from '../components/ThemeToggle.astro';
import LibraryLink from '../components/LibraryLink.astro';
import { SHARE_WIDTH, SHARE_HEIGHT } from '../lib/share-image';
import sunflowerSvg from '../../public/favicon.svg?raw';

// The favicon, recoloured so it can sit muted and turn coral like the nav.
const sunflower = sunflowerSvg.replace('fill="#e07a6a"', 'fill="currentColor"');

interface Props {
  title?: string;
  description?: string;
  /** Root-relative or absolute URL of the 1200×630 JPEG share image, for link previews. */
  image?: string;
  type?: 'website' | 'article';
  /** Article pages pass their ISO date; emitted as article:published_time. */
  publishedTime?: string;
  /** Home uses the wider column; header and footer follow it. */
  wide?: boolean;
  /** Home shows the tagline in its about line, so the footer drops it. */
  hideTagline?: boolean;
  /** The largest image above the fold, requested before the fonts. */
  preloadImage?: string;
  /** Pages with a prose body preload the body font. */
  preloadBody?: boolean;
  /** Pages that show the title face in italic above the fold preload that cut too. */
  preloadSerifItalic?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  wide = false,
  hideTagline = false,
  preloadImage,
  preloadBody = false,
  preloadSerifItalic = false,
} = Astro.props;

const serifPreload = preloadSerifItalic ? [{ style: 'normal' }, { style: 'italic' }] : [{ style: 'normal' }];

const column = wide ? 'column column-wide' : 'column';

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const nav = [
  { key: 'work', href: '/work/', label: 'Work' },
  { key: 'mind', href: '/mind/', label: 'Mind' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const currentSection = path.split('/')[1];
const current = (key: string) => {
  if (currentSection !== key) return undefined;
  return path === `/${key}` ? 'page' : 'true';
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f14" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ec" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content={String(SHARE_WIDTH)} />}
    {ogImage && <meta property="og:image:height" content={String(SHARE_HEIGHT)} />}
    {ogImage && <meta property="og:image:type" content="image/jpeg" />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <Font cssVariable="--font-serif" preload={serifPreload} />
    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    {preloadBody ? <Font cssVariable="--font-body" preload={[{ style: 'normal', weight: 400 }]} /> : <Font cssVariable="--font-body" />}
  </head>
  <body>
    <header class={`site-header ${column}`}>
      <a class="site-home" href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V21h14V9.5" />
          <path d="M10 21v-6h4v6" />
        </svg>
      </a>
      <div class="site-right">
        <nav class="site-nav" aria-label="Sections">
          {nav.map((item) => <a href={item.href} aria-current={current(item.key)}>{item.label}</a>)}
          {LIBRARY_PUBLIC && <LibraryLink current={current('library')} />}
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <!-- Appears top-right once the header has scrolled away; click unfolds the header row.
         On touch screens the mark can be dragged to either side or tucked off the edge (see the script). -->
    <div class="corner">
      <nav class="corner-row" id="corner-menu" aria-label="Sections">
        <a class="corner-home" href="/" aria-label="Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9.5V21h14V9.5" />
            <path d="M10 21v-6h4v6" />
          </svg>
        </a>
        {nav.map((item) => <a href={item.href} aria-current={current(item.key)}>{item.label}</a>)}
        {LIBRARY_PUBLIC && <LibraryLink current={current('library')} />}
        <ThemeToggle maskId="sun-moon-mask-corner" />
      </nav>
      <button class="corner-mark" type="button" aria-expanded="false" aria-controls="corner-menu" aria-label="Menu" set:html={sunflower} />
    </div>
    <main>
      <slot />
    </main>
    <footer class={`site-footer ${column}`}>
      <!-- The name and, at the far right, the AI disclaimer are buttons; each unfolds a note above itself,
           like the corner menu unfolds beside its mark. The name's note holds the profile links. -->
      <div class="popover">
        <button class="popover-button" type="button" aria-expanded="false" aria-controls="social-links">{SITE.shortName}</button>
        <ul class="popover-note social-links" id="social-links">
          <li>
            <a href={SITE.social.linkedin} target="_blank" rel="me noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="5.75" cy="5" r="1.6" fill="currentColor" stroke="none" />
                <path d="M5.75 9.75v10" />
                <path d="M10.75 19.75v-10" />
                <path d="M10.75 13.75a3.75 3.75 0 0 1 7.5 0v6" />
              </svg>
            </a>
          </li>
          <li>
            <a href={SITE.social.instagram} target="_blank" rel="me noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="3.75" />
                <circle cx="17.25" cy="6.75" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
      {!hideTagline && <p class="site-tagline">{SITE.tagline}</p>}
      <div class="popover disclaimer">
        <button class="popover-button" type="button" aria-expanded="false" aria-controls="ai-disclaimer">{SITE.aiDisclaimer.label}</button>
        <p class="popover-note" id="ai-disclaimer">{SITE.aiDisclaimer.text}</p>
      </div>
    </footer>
    <script is:inline>
      // The JavaScript on the site: the theme toggle, the footer notes and the corner menu
      // (which, on touch screens, can be dragged about and tucked away).
      // Without it the site follows the system scheme, the notes stay folded and the header stays at the top.
      (() => {
        const root = document.documentElement;

        // Theme: every sun/moon button on the page toggles it.
        const buttons = [...document.querySelectorAll('[data-toggle-theme]')];
        const current = () =>
          root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const sync = () => {
          const theme = current();
          for (const b of buttons) {
            b.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
          }
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = theme === 'light' ? '#f5f2ec' : '#0b0f14';
          }
        };
        // Read the stored choice again: after a back/forward cache restore
        // (the startup script does not run then) and when another tab changes it.
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {}
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
          else delete root.dataset.theme;
          sync();
        };
        for (const b of buttons) {
          b.addEventListener('click', () => {
            const next = current() === 'light' ? 'dark' : 'light';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
            sync();
          });
        }
        addEventListener('pageshow', (event) => {
          if (event.persisted) apply();
        });
        addEventListener('storage', (event) => {
          if (event.key === 'theme') apply();
        });
        sync();

        // Footer notes: the name and the AI disclaimer each unfold a note above their button.
        // Opening one folds the other; Escape and a click elsewhere fold both.
        const notes = [...document.querySelectorAll('.popover')]
          .map((el) => ({ el, button: el.querySelector('.popover-button') }))
          .filter((note) => note.button);
        const setNoteOpen = (note, open) => {
          note.el.classList.toggle('is-open', open);
          note.button.setAttribute('aria-expanded', String(open));
        };
        for (const note of notes) {
          note.button.addEventListener('click', () => {
            const open = !note.el.classList.contains('is-open');
            for (const other of notes) setNoteOpen(other, other === note && open);
          });
        }
        addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          for (const note of notes) {
            if (!note.el.classList.contains('is-open')) continue;
            setNoteOpen(note, false);
            note.button.focus();
          }
        });
        addEventListener('click', (event) => {
          for (const note of notes) {
            if (!note.el.contains(event.target)) setNoteOpen(note, false);
          }
        });

        // Corner menu: the sunflower shows while the header is off screen.
        const corner = document.querySelector('.corner');
        const header = document.querySelector('.site-header');
        const mark = corner && corner.querySelector('.corner-mark');
        if (!corner || !header || !mark || !('IntersectionObserver' in window)) return;
        // On touch screens the mark can be moved (below). `place` is where it
        // was dropped, or null for the default top-right; when it is tucked
        // into a corner, a tap on its tab shows it ("peeking") for as long as
        // the row is open.
        let place = null;
        let peeking = false;
        let drag = null;
        let lastDrop = 0;
        let applyPlace = () => {};
        const setOpen = (open) => {
          corner.classList.toggle('is-open', open);
          mark.setAttribute('aria-expanded', String(open));
          if (!open && peeking) {
            peeking = false;
            applyPlace();
          }
        };
        new IntersectionObserver(([entry]) => {
          const away = !entry.isIntersecting;
          corner.classList.toggle('is-visible', away);
          if (!away) setOpen(false);
        }).observe(header);
        mark.addEventListener('click', () => {
          if (performance.now() - lastDrop < 300) return; // the click that ends a drag
          if (place && place.tucked && !peeking) {
            peeking = true;
            applyPlace();
            setOpen(true);
            return;
          }
          setOpen(!corner.classList.contains('is-open'));
        });
        addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
        addEventListener('click', (event) => {
          if (!corner.contains(event.target)) setOpen(false);
        });

        // Touch screens: the mark can be dragged to any height on either side,
        // or pushed off a side of the screen, where it tucks into the nearest
        // corner and leaves a small tab on the edge. The spot is kept per device.
        if (!matchMedia('(pointer: coarse)').matches || !('PointerEvent' in window)) return;
        const rest = getComputedStyle(corner);
        const EDGE_X = parseFloat(rest.right) || 20;
        const EDGE_Y = parseFloat(rest.top) || 18;
        const TUCK = 16; // a mark dropped with its centre this close to a side edge tucks away
        const SETTLE = 260; // ms, a little over the glide in the stylesheet
        const clamp = (value, low, high) => Math.min(Math.max(value, low), high);
        const viewWidth = () => document.documentElement.clientWidth;
        const offsetLimit = () => innerHeight - mark.offsetHeight - EDGE_Y;
        const inTuckZone = (centreX) => centreX < TUCK || centreX > viewWidth() - TUCK;
        // While moving, the mark is placed by left/top so the drop can glide;
        // applyPlace then anchors it to its nearest edges, so it stays put
        // when the browser bars change the height of the viewport.
        const setBox = (left, top) => {
          const s = corner.style;
          s.left = `${left}px`;
          s.top = `${top}px`;
          s.right = 'auto';
          s.bottom = 'auto';
        };
        const setClasses = () => {
          corner.classList.toggle('is-left', place.side === 'left');
          corner.classList.toggle('is-tucked', place.tucked && !peeking);
        };
        const insets = () => ({
          x: place.tucked && !peeking ? 0 : EDGE_X,
          y: place.tucked ? EDGE_Y : clamp(place.offset, EDGE_Y, offsetLimit()),
        });
        applyPlace = () => {
          if (!place || drag) return;
          setClasses();
          const { x, y } = insets();
          const s = corner.style;
          s.left = place.side === 'left' ? `${x}px` : 'auto';
          s.right = place.side === 'right' ? `${x}px` : 'auto';
          s.top = place.anchor === 'top' ? `${y}px` : 'auto';
          s.bottom = place.anchor === 'bottom' ? `${y}px` : 'auto';
        };
        let settleTimer;
        const settle = () => {
          setClasses();
          const { x, y } = insets();
          setBox(
            place.side === 'left' ? x : viewWidth() - mark.offsetWidth - x,
            place.anchor === 'top' ? y : innerHeight - mark.offsetHeight - y,
          );
          clearTimeout(settleTimer);
          settleTimer = setTimeout(applyPlace, SETTLE);
        };
        try {
          const stored = JSON.parse(localStorage.getItem('corner'));
          if (
            stored &&
            (stored.side === 'left' || stored.side === 'right') &&
            (stored.anchor === 'top' || stored.anchor === 'bottom')
          ) {
            place = {
              side: stored.side,
              anchor: stored.anchor,
              offset: Number(stored.offset) || EDGE_Y,
              tucked: Boolean(stored.tucked),
            };
            // Put it there without the glide: the page may load scrolled down.
            corner.classList.add('is-dragging');
            applyPlace();
            void corner.offsetWidth;
            corner.classList.remove('is-dragging');
          }
        } catch {}
        addEventListener('resize', applyPlace);

        mark.addEventListener('pointerdown', (event) => {
          if (!event.isPrimary || drag) return;
          const box = mark.getBoundingClientRect();
          drag = { id: event.pointerId, x: event.clientX, y: event.clientY, left: box.left, top: box.top, moved: false };
          mark.setPointerCapture(event.pointerId);
        });
        mark.addEventListener('pointermove', (event) => {
          if (!drag || event.pointerId !== drag.id) return;
          const dx = event.clientX - drag.x;
          const dy = event.clientY - drag.y;
          if (!drag.moved) {
            if (Math.hypot(dx, dy) < 6) return; // still a tap; the click handler takes it
            drag.moved = true;
            peeking = false;
            setOpen(false);
            clearTimeout(settleTimer);
            corner.classList.add('is-dragging');
            corner.classList.remove('is-tucked');
          }
          const w = mark.offsetWidth;
          const h = mark.offsetHeight;
          const left = clamp(drag.left + dx, -w / 2, viewWidth() - w / 2);
          const top = clamp(drag.top + dy, 0, innerHeight - h);
          setBox(left, top);
          corner.classList.toggle('is-tucking', inTuckZone(left + w / 2));
        });
        const drop = (event) => {
          if (!drag || event.pointerId !== drag.id) return;
          const { moved } = drag;
          drag = null;
          if (!moved) return;
          lastDrop = performance.now();
          corner.classList.remove('is-dragging', 'is-tucking');
          const box = mark.getBoundingClientRect();
          const centreX = box.left + box.width / 2;
          const anchor = box.top + box.height / 2 < innerHeight / 2 ? 'top' : 'bottom';
          place = {
            side: centreX < viewWidth() / 2 ? 'left' : 'right',
            anchor,
            offset: clamp(anchor === 'top' ? box.top : innerHeight - box.bottom, EDGE_Y, offsetLimit()),
            tucked: inTuckZone(centreX),
          };
          try {
            localStorage.setItem('corner', JSON.stringify(place));
          } catch {}
          settle();
        };
        mark.addEventListener('pointerup', drop);
        mark.addEventListener('pointercancel', drop);
      })();
    </script>
  </body>
</html>
