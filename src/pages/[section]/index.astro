---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { SECTIONS, SECTION_KEYS, type Section } from '../../site';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
  return SECTION_KEYS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as Section;
const entry = SECTIONS[section];
const { title, description } = entry;
const about = 'about' in entry ? entry.about : undefined;
const posts = await getPosts(section);
---

<Base title={title} description={description}>
  <div class="column">
    <h1 class="sr-only">{title}</h1>
    {about && <p class="section-about">{about}</p>}
    <PostList posts={posts} />
  </div>
</Base>
