---
import Base from '../layouts/Base.astro';
import PostStrips from '../components/PostStrips.astro';
import { SECTIONS, SECTION_KEYS, SITE } from '../site';
import { coverUrl, getPosts } from '../lib/posts';

/** How many of each section's latest posts the home page shows. */
const LATEST = 2;

const columns = await Promise.all(
  SECTION_KEYS.map(async (section) => ({
    section,
    title: SECTIONS[section].title,
    about: SECTIONS[section].about,
    posts: (await getPosts(section)).slice(0, LATEST),
  })),
);

const firstPost = columns.flatMap((column) => column.posts)[0];
const preloadImage = firstPost ? coverUrl(firstPost.data.cover) : undefined;
---

<Base wide hideTagline preloadImage={preloadImage} preloadSerifItalic>
  <div class="column column-wide">
    <h1 class="sr-only">{SITE.name}</h1>
    <p class="home-about">Some of my conversations with Claude, synthesized into blog posts documenting my learning journey.</p>
    <div class="home">
      {
        columns.map(({ section, title, about, posts }, index) => (
          <>
            {index > 0 && <div class="home-divider" aria-hidden="true" />}
            <section class="home-section">
              <h2 class="home-label">
                <a href={`/${section}/`}>{title}</a>
              </h2>
              <p class="home-section-about">{about}</p>
              <div class="home-latest">
                <PostStrips posts={posts} />
              </div>
              {posts.length > 0 && (
                <a
                  class="home-more"
                  href={`/${section}/`}
                  aria-label={`All ${title} posts`}
                  data-tip="See all articles"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="5" cy="12" r="1.75" />
                    <circle cx="12" cy="12" r="1.75" />
                    <circle cx="19" cy="12" r="1.75" />
                  </svg>
                </a>
              )}
            </section>
          </>
        ))
      }
    </div>
  </div>
</Base>
